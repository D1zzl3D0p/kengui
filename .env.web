# Web-only build overrides, loaded exclusively when Vite runs with `--mode web`
# (see the `dev:web` / `build:web` scripts). The desktop build never loads this
# file, so it keeps the local kenkui runtime option.
#
# app.kenkui.fm is a hosted static SPA with no Tauri sidecar, so it cannot spawn
# or manage a local kenkui process. Hide the "Local (managed)" runtime option.
# The production build reads runtime env from the Cloudflare Pages dashboard; a
# committed mode file guarantees this stays false regardless of dashboard config.
VITE_KENGUI_ENABLE_LOCAL=false
