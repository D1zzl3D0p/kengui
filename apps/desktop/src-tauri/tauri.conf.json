{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kengui",
  "version": "0.1.0",
  "identifier": "app.kengui.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:desktop-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build:desktop-ui",
    "frontendDist": "../../../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Kengui",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
