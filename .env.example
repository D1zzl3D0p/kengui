# Kengui desktop client configuration.
# Vite embeds every VITE_* value into the client bundle at build time, so a
# rebuild/restart is required after changing any of these.

# --- Runtime toggles ---
# Enable the "Kengui Cloud" hosted runtime option in the connect screen.
VITE_KENGUI_ENABLE_HOSTED=true
# Set to "false" to hide the local kenkui runtime option.
VITE_KENGUI_ENABLE_LOCAL=true

# --- Supabase Auth (fixed hosted project) ---
# "Kengui Cloud" targets ONE fixed hosted Supabase project. Point these at that
# project and use its OWN public anon/publishable key from the Supabase
# dashboard. Never use the local `supabase-demo` key or a local `sb_publishable_`
# key here: they are project-scoped to the local stack and a hosted project will
# reject them with `401 Invalid API key`. Never put an `sb_secret_` or
# service-role key in a client build.
#
# Local development against the Supabase CLI stack: set VITE_SUPABASE_URL to the
# local API URL and VITE_SUPABASE_ANON_KEY to the legacy JWT ANON_KEY from
# `supabase status` (the local Auth token route rejects the publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the GitHub/provider callback URL when using a custom auth
# domain. Defaults to <VITE_SUPABASE_URL origin>/auth/v1/callback.
# VITE_SUPABASE_PROVIDER_CALLBACK_URL=

# --- Hosted runtime / Edge Functions ---
# Hosted control-plane origin shown (read-only) in the connect screen.
VITE_KENGUI_HOSTED_URL=
# Set only when the Edge Functions endpoint differs from the hosted origin.
# VITE_KENKUI_CLOUD_FUNCTIONS_URL=
