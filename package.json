{
  "name": "kengui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop-ui": "vite --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:web",
    "build:web": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "build:desktop-ui": "npm run typecheck && vite build --config apps/desktop/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "pages:deploy": "npm run build:web && wrangler pages deploy",
    "tauri": "cd apps/desktop && tauri",
    "desktop:build": "cd apps/desktop && tauri build",
    "desktop:build:debug": "cd apps/desktop && tauri build --debug",
    "test": "npm run test:architecture && vitest run --config apps/web/vite.config.ts",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:watch": "vitest --config apps/web/vite.config.ts",
    "selftest:auth": "node scripts/selftest-local-supabase-auth.mjs",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:ensure": "node -e \"process.exit(require('fs').existsSync('packages/app/src/api/generated/meta.ts')?0:1)\" || npm run contract:generate",
    "predev": "npm run contract:ensure",
    "predev:web": "npm run contract:ensure",
    "predev:desktop-ui": "npm run contract:ensure",
    "pretypecheck": "npm run contract:ensure",
    "prebuild": "npm run contract:ensure",
    "prebuild:web": "npm run contract:ensure",
    "prebuild:desktop-ui": "npm run contract:ensure",
    "pretest": "npm run contract:ensure",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm test -- --run && npm run build:web && npm run build:desktop-ui && npm run check:rust"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.99.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.1",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.1.4",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  }
}
